#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# /weekly — Silicon Mind Weekly Review Generator
# ═══════════════════════════════════════════════════════════════
# Run this at the end of each week. It collects all project data
# and generates a ready-to-paste prompt for the Opus Overseer chat.
#
# Usage:
#   ./weekly                    # Print to terminal
#   ./weekly --clipboard        # Copy to clipboard (needs xclip)
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${CYAN}═══════════════════════════════════════════════${NC}"
echo -e "${CYAN}   🔮 Silicon Mind — Weekly Review Generator    ${NC}"
echo -e "${CYAN}═══════════════════════════════════════════════${NC}"
echo ""

# ─── Gather Data ───────────────────────────────────────────────

# 1. Git log for the week
echo -e "${GREEN}📊 Gathering git activity...${NC}"
WEEK_AGO=$(date -d "7 days ago" +%Y-%m-%d 2>/dev/null || date -v-7d +%Y-%m-%d 2>/dev/null || echo "2026-01-01")
GIT_LOG=$(git log --since="$WEEK_AGO" --oneline --all 2>/dev/null || echo "(no commits this week)")
GIT_DIFF_STAT=$(git diff --stat main..dev 2>/dev/null || echo "(no diff between main and dev)")
COMMIT_COUNT=$(git log --since="$WEEK_AGO" --oneline --all 2>/dev/null | wc -l || echo "0")

# 2. Files changed this week
echo -e "${GREEN}📁 Checking changed files...${NC}"
CHANGED_FILES=$(git diff --name-only main..dev 2>/dev/null || echo "(none)")
NEW_FILES=$(git log --since="$WEEK_AGO" --diff-filter=A --name-only --pretty=format:"" --all 2>/dev/null | sort -u | grep -v '^$' || echo "(none)")

# 3. Code stats
echo -e "${GREEN}📏 Counting code lines...${NC}"
PYTHON_LINES=$(find model verification driver scripts -name "*.py" -exec cat {} + 2>/dev/null | wc -l || echo "0")
VERILOG_LINES=$(find rtl -name "*.v" -exec cat {} + 2>/dev/null | wc -l || echo "0")
TEST_LINES=$(find verification -name "*.py" -exec cat {} + 2>/dev/null | wc -l || echo "0")

# 4. Staging status
echo -e "${GREEN}📥 Checking staging area...${NC}"
STAGING_PENDING=$(grep -c "Awaiting\|PENDING" STAGING.md 2>/dev/null || echo "0")

# 5. File status from condensifier
echo -e "${GREEN}🧊 Running condensifier...${NC}"
CONDENSED=$(python3 condense_context.py 2>/dev/null | head -60)

# 6. Current blocking items
BLOCKERS=$(grep -A 5 "Blockers" PROJECT_CONTEXT.md 2>/dev/null | tail -4 || echo "(none listed)")

# ─── Generate the Review Prompt ────────────────────────────────

echo -e "${GREEN}✍️  Generating review prompt...${NC}"
echo ""

REVIEW_PROMPT="=== WEEKLY REVIEW REQUEST — $(date +%Y-%m-%d) ===

/weekly — Please do the weekly review for Silicon Mind.

## This Week's Activity

**Commits this week:** ${COMMIT_COUNT}
**Git log:**
${GIT_LOG}

**Diff stats (dev vs main):**
${GIT_DIFF_STAT}

**New files added:**
${NEW_FILES}

**Changed files:**
${CHANGED_FILES}

## Code Volume
- Python code: ${PYTHON_LINES} lines (model/, verification/, driver/)
- Verilog code: ${VERILOG_LINES} lines (rtl/)
- Test code: ${TEST_LINES} lines (verification/)

## Staging Area
- Pending reviews: ${STAGING_PENDING} submissions in STAGING.md

## Current Project Context
${CONDENSED}

## Current Blockers
${BLOCKERS}

## What I Need You (Opus Overseer) To Do:
1. **Audit** all code changes from this week for quality and correctness
2. **Check** if the work aligns with the project plan and timeline
3. **Update** WEEKLY_REVIEW.md with your findings
4. **Decide** if dev branch is ready to merge into main
5. **Ask** me about Shaurya's hardware progress if relevant
6. **Plan** next week's priorities
7. **Flag** any risks, blockers, or course corrections needed

=== END WEEKLY REVIEW REQUEST ==="

# ─── Output ────────────────────────────────────────────────────

if [[ "${1:-}" == "--clipboard" ]]; then
    echo "$REVIEW_PROMPT" | xclip -selection clipboard 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ Weekly review prompt copied to clipboard!${NC}"
        echo -e "${YELLOW}   Paste it into your Opus Overseer chat.${NC}"
    else
        echo -e "${YELLOW}⚠️  xclip not found. Install: sudo dnf install xclip${NC}"
        echo ""
        echo "$REVIEW_PROMPT"
    fi
else
    echo "$REVIEW_PROMPT"
fi

echo ""
echo -e "${CYAN}───────────────────────────────────────────────${NC}"
CHARS=$(echo "$REVIEW_PROMPT" | wc -c)
TOKENS=$((CHARS / 4))
echo -e "${GREEN}📊 Stats: ${CHARS} chars | ~${TOKENS} tokens${NC}"
echo -e "${YELLOW}📋 Paste this into your Opus Overseer (this Antigravity chat)${NC}"
echo -e "${CYAN}───────────────────────────────────────────────${NC}"
